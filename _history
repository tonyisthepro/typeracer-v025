Word\n"]]},{"start1":1964,"length1":12,"diffs":[[1,""]]},{"start1":2013,"length1":107,"diffs":[[1,"    if (false) {\n    \t\n"]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":238,"length1":44,"diffs":[[1,""]]}]},{"type":"added","filename":"test.ts","value":"// tests go here; this will not be compiled when this package is used as an extension.\n"}]}],"snapshots":[{"timestamp":1771630050916,"editorVersion":"8.0.18","text":{"main.blocks":"<xml xmlns=\"http://www.w3.org/1999/xhtml\">\n  <block type=\"pxt-on-start\"></block>\n  <block type=\"device_forever\"></block>\n</xml>","main.ts":"\n","README.md":"","pxt.json":"{\n    \"name\": \"Untitled\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\"\n    ],\n    \"additionalFilePaths\": []\n}\n"}},{"timestamp":1779998750307,"editorVersion":"8.0.22","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"device_forever\" x=\"225\" y=\"20\"></block><block type=\"pxt-on-start\" x=\"132\" y=\"237\"><statement name=\"HANDLER\"><block type=\"device_show_leds\"><field name=\"LEDS\">`\n        # # # # # \n        # . # . . \n        # # # # # \n        . . # . # \n        # # # . #\n        `</field></block></statement></block></xml>","main.ts":"/**\n * Typing Racer for micro:bit\n *\n * Made for MakeCode - uses LED + serial output\n *\n * Controls:\n * - Button A → Previous letter\n * - Button B → Next letter\n * - A + B → Select letter\n * - Logo → Submit full word\n */\n\nfunction resetGame() {\n    score = 0\n    serial.writeLine(\"=== Typing Racer ===\")\n    serial.writeLine(\"Use A/B to choose letters, A+B to select, Logo to submit word.\")\n    playing = true\n    basic.pause(500)\n    newWord()\n}\n\n// Button A → Previous letter\ninput.onButtonPressed(Button.A, function () {\n    currentLetterIndex = (currentLetterIndex - 1 + alphabet.length) % alphabet.length\n    showLetter()\n})\n\n// Button A+B → Select current letter\ninput.onButtonPressed(Button.AB, function () {\n    if (playing) {\n        inputWord += alphabet.charAt(currentLetterIndex)\n        serial.writeLine(\"Selected: \" + inputWord)\n    }\n})\n\n// Button B → Next letter\ninput.onButtonPressed(Button.B, function () {\n    currentLetterIndex = (currentLetterIndex + 1) % alphabet.length\n    showLetter()\n})\n\n// Show current letter on LEDs\nfunction showLetter() {\n    basic.showString(alphabet.charAt(currentLetterIndex))\n}\n\n// Logo → Submit full word\ninput.onLogoEvent(TouchButtonEvent.Pressed, function () {\n    if (playing) {\n        serial.writeLine(\"You typed: \" + inputWord)\n        if (inputWord == targetWord) {\n            serial.writeLine(\"✅ Correct! You win! 🏆\")\n            basic.showString(\"WIN\")\n            score += 1\n        } else {\n            serial.writeLine(\"❌ Wrong. The word was: \" + targetWord)\n            basic.showString(\"X\")\n        }\n        serial.writeLine(\"Score: \" + score)\n        basic.pause(1000)\n        newWord()\n    }\n})\n\n// Pick a random real word from the list\nfunction generateRandomWord(): string {\n    let index = Math.randomRange(0, wordList.length - 1)\n    return wordList[index]\n}\n\n// Create a new word (non-repeating)\nfunction newWord() {\n    let newTarget = \"\"\n    while (true) {\n        newTarget = generateRandomWord()\n        if (newTarget != targetWord) {\n            break\n        }\n    }\n    targetWord = newTarget\n\n    serial.writeLine(\"\")\n    serial.writeLine(\"Type (\" + targetWord + \")\")\n    basic.pause(300)\n    basic.showString(targetWord)\n\n    inputWord = \"\"\n    currentLetterIndex = 0\n}\n\nlet inputWord = \"\"\nlet targetWord = \"\"\nlet currentLetterIndex = 0\nlet playing = false\nlet score = 0\nlet alphabet = \"abcdefghijklmnopqrstuvwxyz\"\n\n// ✅ Replace random letters with real short words\nlet wordList = [\n    \"cat\", \"dog\", \"sun\", \"fish\", \"tree\", \"ball\", \"book\",\n    \"star\", \"bird\", \"milk\", \"apple\", \"moon\", \"rock\", \"rain\",\n    \"ship\", \"frog\", \"bear\", \"fire\", \"cake\", \"shoe\", \"leaf\",\n    \"wind\", \"snow\", \"cloud\", \"grass\", \"plant\", \"water\", \"light\",\n    \"dark\", \"blue\", \"green\", \"red\", \"yellow\", \"black\", \"white\",\n    \"house\", \"chair\", \"table\", \"phone\", \"clock\", \"glass\", \"brush\",\n    \"smile\", \"laugh\", \"dance\", \"sing\", \"jump\", \"run\", \"walk\",\n    \"drive\", \"train\", \"plane\", \"truck\", \"bus\", \"road\", \"map\",\n    \"game\", \"play\", \"score\", \"win\", \"lose\", \"fast\", \"slow\",\n    \"cold\", \"warm\", \"hot\", \"cool\", \"sweet\", \"sour\", \"salt\",\n    \"bread\", \"fruit\", \"grape\", \"peach\", \"berry\", \"lemon\", \"mango\",\n    \"zebra\", \"lion\", \"tiger\", \"panda\", \"mouse\", \"horse\", \"whale\",\n    \"beach\", \"ocean\", \"river\", \"lake\", \"hill\", \"mount\", \"valley\",\n    \"space\", \"earth\", \"mars\", \"venus\", \"orbit\", \"star\", \"comet\"\n]\n\n\nfunction showBackspaceIcon() {\n    basic.showLeds(`\n        . . . . .\n        . # # # .\n        . . # . .\n        . # # # .\n        . . . . .\n    `)\n}\n\n// Use pin1 connected to GND as a backspace button\nbasic.forever(function () {\n    if (playing && input.pinIsPressed(TouchPin.P1)) {\n        if (inputWord.length > 0) {\n            inputWord = inputWord.substr(0, inputWord.length - 1)\n            serial.writeLine(\"Backspace: \" + inputWord)\n            showBackspaceIcon()\n            basic.pause(500) // debounce delay\n        }\n    }\n})\ninput.onPinPressed(TouchPin.P1, function () {\n    if (playing && inputWord.length > 0) {\n        inputWord = inputWord.substr(0, inputWord.length - 1)\n        serial.writeLine(\"Backspace: \" + inputWord)\n        showBackspaceIcon()\n    }\n})\nlet timeLeft = 60\nlet timerRunning = false\nlet wrongAttempts = 0\n\nfunction startTimer() {\n    timeLeft = 60\n    timerRunning = true\n    control.inBackground(function () {\n        while (timeLeft > 0 && timerRunning) {\n            basic.pause(1000)\n            timeLeft -= 1\n            serial.writeLine(\"Time left: \" + timeLeft + \"s\")\n        }\n        if (timeLeft == 0 && playing) {\n            serial.writeLine(\"⏰ Time's up!\")\n            basic.showString(\"X\")\n            playing = false\n        }\n    })\n}\n\nfunction submitWord() {\n    timerRunning = false\n    serial.writeLine(\"You typed: \" + inputWord)\n    if (inputWord == targetWord) {\n        serial.writeLine(\"✅ Correct! You win! 🏆\")\n        basic.showString(\"WIN\")\n        score += 1\n        wrongAttempts = 0\n    } else {\n        wrongAttempts += 1\n        serial.writeLine(\"❌ Wrong. The word was: \" + targetWord)\n        basic.showString(\"X\")\n        if (wrongAttempts >= 5) {\n            serial.writeLine(\"💀 Game Over: Too many wrong attempts\")\n            basic.showString(\"GAME OVER\")\n            playing = false\n            return\n        }\n    }\n    serial.writeLine(\"Score: \" + score)\n    serial.writeLine(\"Wrong attempts: \" + wrongAttempts)\n    basic.pause(1000)\n    newWord()\n}\n\n\n\n// Start the game\nresetGame()","README.md":"","pxt.json":"{\n    \"name\": \"Untitled\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\"\n    ],\n    \"preferredEditor\": \"tsprj\"\n}\n"}}],"shares":[],"lastSaveTime":1780000093583}